# =====================================================================
# LionHome — environment variables
# Copy to .env.local and fill in. Never commit real secrets.
# =====================================================================

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (ap-southeast-1) ---
# `npx supabase start` prints these for local dev.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server-only, NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Twilio (WhatsApp) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Resend (transactional email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@lionhome.sg

# --- PostHog (analytics, self-hosted-ready) ---
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# --- OneMap (Singapore government — free, requires registration) ---
ONEMAP_API_KEY=

# --- URA REST API (transaction data, free, requires registration) ---
URA_API_KEY=
