# =====================================================================
# LionHome — environment variables
# Copy to .env.local and fill in. Never commit real secrets.
# =====================================================================

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (ap-southeast-1) ---
# `npx supabase start` prints these for local dev.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server-only, NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Twilio (WhatsApp) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Resend (transactional email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@lionhome.sg

# --- PostHog (analytics, self-hosted-ready) ---
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# --- Admin read-only API (app/api/admin/v1/*) ---
# Shared secret; send as `Authorization: Bearer $ADMIN_API_SECRET`.
# Generate with: openssl rand -hex 32
ADMIN_API_SECRET=

# --- OneMap (Singapore government — public search APIs) ---
# Condo MVP uses public OneMap search for geocoding, MRT stations and primary
# schools; no OneMap token/email/password is required for this path.

# --- URA REST API (transaction data, free, requires registration) ---
# The registered AccessKey; the ingest worker exchanges it for a 24h token.
URA_API_KEY=
# Optional: switch between URA's current eservice/v1 endpoints and older .action endpoints.
# Defaults to "v1". If your network/API key only works against the older host, set "legacy".
# URA_ENDPOINT_MODE=v1
# URA_ENDPOINT_MODE=legacy
# Optional explicit overrides, useful while URA endpoint docs/migration are in flux:
# URA_TOKEN_URL=
# URA_DS_URL=

# --- Condo ingestion cron (app/api/cron/condo-ingest) ---
# Shared secret; Vercel Cron sends it as `Authorization: Bearer $CRON_SECRET`.
# Local dev uses CONDO_DEV_FIXTURES=1 instead of a real DB/ingest.
CRON_SECRET=
# Optional dev-only flags (search without a database):
# CONDO_DEV_FIXTURES=1
# CONDO_DEV_ACTIVE_COUNT=50
